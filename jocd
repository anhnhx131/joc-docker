#!/usr/bin/env bash
# jocd — CLI for running a JOC (Japan Open Chain) PoSA Validator Client on
# infrastructure you control, as opposed to the parts done through the
# BCCloud web UI. See README.md for the quickstart, CLAUDE.md for the
# full architecture/security/self-review picture.
#
# Validator-only right now (guide Option 2) — this used to also support
# self-hosting an Execution + Consensus Client (ROLE=el-cl/all, guide
# Option 3, never documented by the official guide). Removed rather than
# carried forward half-finished: it was this project's own best-effort,
# never guide-verified, and not something anyone should trust in
# production. See git history (ROLE=el-cl/all, geth.yml,
# lighthouse-cl-only.yml) if/when that gets properly rebuilt.
#
# Single file, on purpose (modeled after eth-docker's `ethd`): bash
# `source` doesn't create real scoping anyway — a sourced file's
# functions/variables land in the same global namespace as the caller, so
# splitting this across scripts/*.sh never bought any actual isolation,
# only extra indirection. One file is easier to read top-to-bottom, easier
# to audit before you trust it with a mnemonic, and easier to copy around.
#
# Structure:
#   1. Paths, allow-lists (SUPPORTED_*)
#   2. Helpers: logging, confirm(), validators, env/network utilities
#   3. One cmd_<name>() function per subcommand
#   4. usage() + dispatch (case "$1") at the very bottom
#
# The two ethstaker-deposit-cli docker commands and the Step 2-6 import
# command live in staking-deposit-cli.yml + staking-deposit-cli/, not in this file (see
# staking-deposit-cli.yml's header for why), marked with BEGIN/END comments so you
# can diff them directly against the guide text — see README.md's "Verify
# this yourself" section.
set -euo pipefail

# =============================================================================
# 1. Paths and supported values
# =============================================================================
JOCD_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DATA_DIR="$JOCD_ROOT/data"
KEYS_DIR="$DATA_DIR/validator_keys"
NETWORKS_DIR="$JOCD_ROOT/networks"
ENV_FILE="$JOCD_ROOT/.env"
ENV_EXAMPLE="$JOCD_ROOT/.env.example"

# Keep these allow-lists as the single source of truth for what jocd
# currently supports. Adding a new entry here is a deliberate, reviewed
# decision — not something any command should infer on its own.
SUPPORTED_NETWORKS=(mainnet testnet sandbox)
SUPPORTED_CL_CLIENTS=(lighthouse)    # planned, not yet supported: prysm
SUPPORTED_ROLES=(validator)          # el-cl/all removed — see header comment

# =============================================================================
# 2. Helpers
# =============================================================================

# --- logging -----------------------------------------------------------------
COLOR_RED=$'\033[31m'
COLOR_GREEN=$'\033[32m'
COLOR_YELLOW=$'\033[33m'
COLOR_BOLD=$'\033[1m'
COLOR_RESET=$'\033[0m'

info()    { printf '%s\n' "[INFO] $*" >&2; }
success() { printf '%s[OK]%s %s\n' "$COLOR_GREEN" "$COLOR_RESET" "$*" >&2; }
warn()    { printf '%s[WARN]%s %s\n' "$COLOR_YELLOW" "$COLOR_RESET" "$*" >&2; }
error()   { printf '%s[ERROR]%s %s\n' "$COLOR_RED" "$COLOR_RESET" "$*" >&2; }
shout()   { printf '%s%s%s\n' "$COLOR_BOLD$COLOR_RED" "$*" "$COLOR_RESET" >&2; }
die()     { error "$*"; exit 1; }

# confirm "question" -> returns 0 (success) only if the user explicitly
# answers y/yes. Anything else (including empty input) is treated as "no".
confirm() {
  local prompt="${1:-Are you sure?}"
  local answer=""
  read -r -p "$prompt [y/N] " answer || true
  case "$answer" in
    y | Y | yes | YES | Yes) return 0 ;;
    *) return 1 ;;
  esac
}

# confirm_strict "question" "phrase" -> returns 0 only if the user types
# the exact phrase back (case-sensitive). For actions with no undo (e.g.
# deleting key material) where a fat-fingered 'y' shouldn't be enough.
confirm_strict() {
  local prompt="$1" phrase="$2"
  local answer=""
  read -r -p "$prompt (type '$phrase' to confirm): " answer || true
  [[ "$answer" == "$phrase" ]]
}

# --- docker wrapper ------------------------------------------------------------
# Every function below calls plain `docker ...` / `docker compose ...`. This
# shadows that name so a stale 'docker' group membership (the common case
# right after 'jocd install' — usermod -aG docker only takes effect in a NEW
# login session, see check_docker below) is absorbed transparently in one
# place, instead of making the operator run a separate 'newgrp docker'/
# re-login themselves before jocd is usable again. `-E` preserves the calling
# shell's environment (needed for WITHDRAWAL_ADDRESS in cmd_init — see its
# comment); docker-group access is already root-equivalent, so falling back
# to sudo here isn't crossing a new privilege boundary.
DOCKER_NEEDS_SUDO=""
docker() {
  if [[ -n "$DOCKER_NEEDS_SUDO" ]]; then
    sudo -E docker "$@"
  else
    command docker "$@"
  fi
}

# --- preflight checks ---------------------------------------------------------
check_docker() {
  type -P docker >/dev/null 2>&1 \
    || die "Docker is not installed. Run: ./jocd install"

  if ! command docker info >/dev/null 2>&1; then
    # Common case right after 'jocd install': the daemon is up, but this
    # shell's group membership hasn't caught up yet. Fall back to sudo for
    # docker commands for the rest of this invocation instead of dying —
    # see the docker() wrapper above.
    if sudo -n docker info >/dev/null 2>&1; then
      warn "This shell's 'docker' group membership hasn't kicked in yet (usually right after 'jocd install') — using sudo for docker commands this run."
      warn "Log out and back in (or run: newgrp docker) to drop the need for sudo next time."
      DOCKER_NEEDS_SUDO=1
    else
      die "Docker daemon is not running (or not accessible). Start it with: sudo systemctl start docker"
    fi
  fi

  docker compose version >/dev/null 2>&1 \
    || die "'docker compose' (v2 plugin) is not available. Install/upgrade Docker."
  success "Docker is installed and running."
}

# --- validators ----------------------------------------------------------------
# Ethereum-style address: 0x + 40 hex chars = 42 chars total.
is_valid_eth_address() {
  local addr="${1:-}"
  [[ "$addr" =~ ^0x[0-9a-fA-F]{40}$ ]]
}

is_valid_url() {
  local url="${1:-}"
  [[ "$url" =~ ^https?://[A-Za-z0-9.-]+(:[0-9]+)?(/.*)?$ ]]
}

# Cross-platform SHA-256 (macOS has `shasum`, most Linux has `sha256sum`).
# Used so an operator can eyeball/compare a config file's checksum against
# the official source before applying it — config.yaml controls consensus
# rules, so a wrong file is a real risk, not just a formatting nit.
sha256_of() {
  local f="$1"
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$f" | awk '{print $1}'
  elif command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$f" | awk '{print $1}'
  else
    echo "unavailable (no sha256sum/shasum found)"
  fi
}

# --- network / client / role selection -----------------------------------------
_list_contains() {
  local needle="$1"; shift
  local x
  for x in "$@"; do [[ "$x" == "$needle" ]] && return 0; done
  return 1
}

is_supported_network()   { _list_contains "${1:-}" "${SUPPORTED_NETWORKS[@]}"; }
is_supported_cl_client() { _list_contains "${1:-}" "${SUPPORTED_CL_CLIENTS[@]}"; }
is_supported_role()      { _list_contains "${1:-}" "${SUPPORTED_ROLES[@]}"; }

# Compose file(s) to load for a given ROLE, ':'-joined for COMPOSE_FILE.
# One file per client/role (eth-docker convention — see e.g.
# https://github.com/ethstaker/eth-docker/blob/main/lighthouse-vc-only.yml),
# rather than one file with docker-compose 'profiles:' filtering. Only one
# role exists right now (see jocd's header comment for why), but this
# stays a function/single-source-of-truth rather than a hardcoded
# constant so re-adding a role later is additive here, not a rewrite.
compose_files_for_role() {
  case "${1:-}" in
    validator) echo "lighthouse-vc-only.yml" ;;
    *)         return 1 ;;
  esac
}

network_dir()        { echo "$NETWORKS_DIR/$1"; }
network_cl_dir()     { echo "$NETWORKS_DIR/$1/cl"; }

# set_env_var KEY VALUE — create or update a KEY=VALUE line in $ENV_FILE.
set_env_var() {
  local key="$1" value="$2"
  [[ -f "$ENV_FILE" ]] || die "$ENV_FILE not found."
  local tmp
  tmp="$(mktemp)"
  if grep -q "^${key}=" "$ENV_FILE"; then
    sed "s|^${key}=.*|${key}=${value}|" "$ENV_FILE" > "$tmp"
  else
    cp "$ENV_FILE" "$tmp"
    echo "${key}=${value}" >> "$tmp"
  fi
  mv "$tmp" "$ENV_FILE"
}

# Loads .env into the current shell's environment (auto-export), so
# commands can read NETWORK/ROLE/CL_CLIENT/etc. Assumes .env is trusted
# content that jocd itself wrote — same trust model docker compose
# already applies to .env.
load_env() {
  [[ -f "$ENV_FILE" ]] || return 1
  set -a
  # shellcheck disable=SC1090
  source "$ENV_FILE"
  set +a
}

# =============================================================================
# 3. Commands
# =============================================================================

# --- jocd install --------------------------------------------------------------
# Install Docker (Engine + compose plugin), the only prerequisite jocd
# actually needs.
#
# Deliberately narrow compared to eth-docker's `ethd install`: this only
# installs Docker. It does NOT tune the OS (swappiness, noatime, chrony/NTP),
# does NOT install unrelated packages, and does NOT touch anything under
# validator_keys/. A tool that's about to handle a mnemonic shouldn't also
# be doing broad root-level OS provisioning — see README.md's
# "Compared to eth-docker's ethd" section.
#
# Every `sudo` command this will run is shown to you before it runs, and
# you're asked to confirm once before any of them execute.
_install_run_steps() {
  # Prints every command first, asks once, then runs them for real.
  local -a cmds=("$@")
  echo >&2
  info "The following commands will run (all via sudo where needed):"
  local c
  for c in "${cmds[@]}"; do echo "  $ $c" >&2; done
  echo >&2
  confirm "Proceed?" || die "Aborted. Nothing was installed."
  for c in "${cmds[@]}"; do
    info "Running: $c"
    eval "$c"
  done
}

cmd_install() {
  info "=== jocd install — Docker prerequisite check/install ==="

  if command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1 && docker compose version >/dev/null 2>&1; then
    success "Docker is already installed and running, with the compose plugin. Nothing to do."
    docker --version
    docker compose version
    return 0
  fi

  [[ -f /etc/os-release ]] || die "Cannot detect your OS (/etc/os-release not found). Install Docker manually: https://docs.docker.com/engine/install/"
  # shellcheck disable=SC1091
  source /etc/os-release
  local os_id="${ID:-}" os_id_like="${ID_LIKE:-}"

  command -v sudo >/dev/null 2>&1 || die "sudo is required to install Docker. Install Docker manually if you don't have it: https://docs.docker.com/engine/install/"

  case "$os_id" in
    ubuntu | debian)
      info "Detected $PRETTY_NAME — using Docker's official apt repository."
      _install_run_steps \
        "sudo apt-get update -y" \
        "sudo apt-get install -y ca-certificates curl gnupg" \
        "sudo install -m 0755 -d /etc/apt/keyrings" \
        "sudo curl -fsSL https://download.docker.com/linux/${os_id}/gpg -o /etc/apt/keyrings/docker.asc" \
        "sudo chmod a+r /etc/apt/keyrings/docker.asc" \
        "echo \"deb [arch=\$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/${os_id} \$(. /etc/os-release && echo \"\$VERSION_CODENAME\") stable\" | sudo tee /etc/apt/sources.list.d/docker.list > /dev/null" \
        "sudo apt-get update -y" \
        "sudo apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin"
      ;;
    amzn)
      # Docker's official docker-ce repo does NOT work here: it's keyed off
      # $releasever, and Amazon Linux's $releasever (e.g. "2023.12.20260803"
      # on AL2023) doesn't match any path Docker actually publishes under
      # download.docker.com/linux/centos/ — `dnf config-manager --add-repo`
      # silently adds a repo that 404s on the real install step. Amazon
      # Linux ships its own Docker Engine build instead; only the compose
      # plugin needs a manual step (dnf has no docker-compose-plugin package
      # here), so pull the same plugin binary Docker publishes on GitHub
      # straight into a system-wide CLI plugin directory Docker already
      # searches (works for every user, not just the one running this).
      case "${VERSION_ID:-}" in
        2)
          warn "Detected $PRETTY_NAME (Amazon Linux 2). Using amazon-linux-extras"
          warn "for Docker Engine — this path is best-effort, not as thoroughly"
          warn "verified as the Ubuntu/Debian path."
          _install_run_steps \
            "sudo amazon-linux-extras install docker -y" \
            "sudo systemctl enable --now docker" \
            "sudo mkdir -p /usr/libexec/docker/cli-plugins" \
            "sudo curl -fsSL \"https://github.com/docker/compose/releases/latest/download/docker-compose-linux-\$(uname -m)\" -o /usr/libexec/docker/cli-plugins/docker-compose" \
            "sudo chmod +x /usr/libexec/docker/cli-plugins/docker-compose"
          ;;
        *)
          warn "Detected $PRETTY_NAME. Installing Docker Engine from Amazon"
          warn "Linux's own repo (not Docker's docker-ce repo, which doesn't"
          warn "support Amazon Linux) plus the compose plugin from Docker's"
          warn "GitHub releases. Best-effort, not as thoroughly verified as"
          warn "the Ubuntu/Debian path."
          _install_run_steps \
            "sudo dnf -y install docker" \
            "sudo systemctl enable --now docker" \
            "sudo mkdir -p /usr/libexec/docker/cli-plugins" \
            "sudo curl -fsSL \"https://github.com/docker/compose/releases/latest/download/docker-compose-linux-\$(uname -m)\" -o /usr/libexec/docker/cli-plugins/docker-compose" \
            "sudo chmod +x /usr/libexec/docker/cli-plugins/docker-compose"
          ;;
      esac
      ;;
    rhel | centos | fedora | rocky | almalinux)
      warn "Detected $PRETTY_NAME. Docker's official repos target upstream"
      warn "RHEL/CentOS/Fedora — this path is best-effort, not as thoroughly"
      warn "verified as the Ubuntu/Debian path."
      _install_run_steps \
        "sudo dnf -y install dnf-plugins-core" \
        "sudo dnf config-manager --add-repo https://download.docker.com/linux/centos/docker-ce.repo" \
        "sudo dnf -y install docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin" \
        "sudo systemctl enable --now docker"
      ;;
    *)
      if [[ "$os_id_like" == *debian* ]]; then
        die "Unrecognized distro '$os_id' (debian-like). Follow the Debian steps manually: https://docs.docker.com/engine/install/debian/"
      fi
      die "Unsupported/unrecognized distro '$os_id' ($PRETTY_NAME). Install Docker manually: https://docs.docker.com/engine/install/"
      ;;
  esac

  # Make sure the daemon is actually up (apt path installs+starts it via the
  # systemd unit shipped in the package; this is a no-op if already running).
  sudo systemctl enable --now docker >/dev/null 2>&1 || true

  if ! groups "$USER" | grep -qw docker; then
    info "Adding $USER to the 'docker' group (to run docker without sudo)..."
    sudo usermod -aG docker "$USER"
    warn "Group membership only takes effect in a NEW login session — 'jocd'"
    warn "itself falls back to sudo automatically in the meantime, but plain"
    warn "'docker' commands you type yourself won't work until you log out"
    warn "and back in (or run: newgrp docker)."
  else
    info "$USER is already in the 'docker' group."
  fi

  echo >&2
  if docker info >/dev/null 2>&1; then
    success "Docker installed and working:"
  else
    warn "Docker was installed, but this shell can't talk to it yet — most"
    warn "likely you need to log out/in (or run 'newgrp docker') to pick up"
    warn "the new 'docker' group membership."
  fi
  docker --version || true
  docker compose version || true
}

# --- jocd init -----------------------------------------------------------------
# Set up this node (guide Option 2, Recommended — the only role this CLI
# supports): Step 2-1, 2-2, 2-6, 2-7, 2-8 — directories, consensus config,
# password/mnemonic/keys/deposit data, import into Lighthouse, start the
# Validator Client via docker compose, print the deposit data path +
# confidentiality warning.
#
# Steps 2-3, 2-4, 2-5 (Transaction Cluster, Validator Cluster, Consensus
# HTTP API on BCCloud) are manual UI steps on BCCloud and are NOT performed
# here — see README.md.
#
# Safe to re-run: steps that already have output on disk are skipped
# rather than silently overwritten.
cmd_init() {
  info "=== jocd init — JOC PoSA Validator Client setup ==="

  check_docker

  # --- Network selection ---------------------------------------------
  if [[ -f "$ENV_FILE" ]]; then
    load_env
    info "Existing .env found — reusing NETWORK=${NETWORK:-<unset>}."
    info "(To change network, edit .env by hand or start a fresh checkout, then re-run.)"
  fi

  NETWORK="${NETWORK:-}"
  if ! is_supported_network "$NETWORK"; then
    echo "Supported networks: ${SUPPORTED_NETWORKS[*]}" >&2
    read -r -p "Which network? [mainnet]: " NETWORK
    NETWORK="${NETWORK:-mainnet}"
    is_supported_network "$NETWORK" || die "Unsupported network '$NETWORK'. Supported: ${SUPPORTED_NETWORKS[*]}"
  fi
  export NETWORK

  # Only one ROLE exists right now (see jocd's header comment) — still
  # validated against SUPPORTED_ROLES rather than hardcoded, so an old
  # .env with a since-removed ROLE value fails loudly instead of silently
  # doing the wrong thing.
  ROLE="${ROLE:-validator}"
  is_supported_role "$ROLE" \
    || die "Unsupported ROLE '$ROLE' in $ENV_FILE. Only 'validator' is supported right now."
  export ROLE

  CL_CLIENT="${CL_CLIENT:-lighthouse}"
  is_supported_cl_client "$CL_CLIENT" \
    || die "Unsupported CL_CLIENT '$CL_CLIENT'. Currently supported: ${SUPPORTED_CL_CLIENTS[*]}."

  local compose_file
  compose_file="$(compose_files_for_role "$ROLE")"
  success "Network: $NETWORK | compose file(s): $compose_file | CL: $CL_CLIENT"

  local cl_dir
  cl_dir="$(network_cl_dir "$NETWORK")"

  # --- Step 2-1: directory structure ----------------------------------------
  info "Preparing data directory structure..."
  if [[ -d "$KEYS_DIR" ]] && [[ -n "$(ls -A "$KEYS_DIR" 2>/dev/null || true)" ]]; then
    warn "$KEYS_DIR already exists and is not empty."
    if ! confirm "Continue and reuse the existing directory (nothing will be deleted)?"; then
      info "To start over instead: 'jocd destroy' (permanently deletes"
      info "keys/deposit data/.env — only if you're sure you don't need them)."
      die "Aborted by user. Nothing was changed."
    fi
  fi
  mkdir -p "$KEYS_DIR"
  success "Directory structure ready under $DATA_DIR"

  cd "$DATA_DIR"

  # --- Step 2-1 (cont'd): consensus config files ----------------------------
  info "Checking consensus config files under $cl_dir ..."
  if [[ ! -f "$cl_dir/config.yaml" || ! -f "$cl_dir/deposit_contract_block.txt" ]]; then
    cat >&2 <<EOF

Missing consensus config for network '$NETWORK'. This CLI does not
auto-download it: the JOC page is an HTML docs page, not a raw file URL.

Please do this manually:
  1. Open: https://www.japanopenchain.org/vi/docs/developer/connect-joc/mainnet/
     (or get it from JBF/admin for '$NETWORK' if it's not mainnet)
  2. Download "config.yaml" and "deposit_contract_block.txt".
  3. Place both files in: $cl_dir/
     (or have your team commit them there — see networks/README.md)
  4. Re-run: jocd init

EOF
    die "Consensus config files not found for network '$NETWORK'."
  fi
  success "config.yaml and deposit_contract_block.txt present in $cl_dir"
  info "config.yaml SHA-256: $(sha256_of "$cl_dir/config.yaml")"
  info "If this came from a git-committed copy rather than a fresh manual"
  info "download, double check it still matches the official source."

  # --- Validator setup — Guide Step 2-2, 2-6 -------
  # The actual key-generation/import docker commands live in
  # staking-deposit-cli.yml + staking-deposit-cli/, not here — see staking-deposit-cli.yml's
  # header comment for why it's kept separate
  # (independent tweaking, most security-sensitive part of this project).
  # This block only collects the withdrawal address and invokes compose;
  # jocd never touches the mnemonic itself.
  info "Validator setup: withdrawal address"
  if [[ -n "${VALIDATOR_WITHDRAWAL_ADDRESS:-}" ]] && is_valid_eth_address "${VALIDATOR_WITHDRAWAL_ADDRESS:-}"; then
    info "Using VALIDATOR_WITHDRAWAL_ADDRESS from environment: $VALIDATOR_WITHDRAWAL_ADDRESS"
  else
    while true; do
      read -r -p "Enter the receiver withdrawal address obtained in Step 1-1 (0x...): " VALIDATOR_WITHDRAWAL_ADDRESS
      if is_valid_eth_address "$VALIDATOR_WITHDRAWAL_ADDRESS"; then
        break
      fi
      error "Invalid address. Expected 0x followed by 40 hex characters (42 chars total)."
    done
  fi
  export VALIDATOR_WITHDRAWAL_ADDRESS
  # staking-deposit-cli.yml's `${WITHDRAWAL_ADDRESS:?...}` is resolved by
  # docker compose while it PARSES the compose file — from the calling
  # shell's environment / .env, never from a `run -e` flag (that only
  # overrides the container's runtime env, applied after parsing
  # succeeds). So this must be a real exported var named exactly
  # WITHDRAWAL_ADDRESS, not just passed via -e below. (Also why the
  # docker() wrapper's sudo fallback above uses `sudo -E` — plain `sudo`
  # would drop this before docker compose ever sees it.)
  export WITHDRAWAL_ADDRESS="$VALIDATOR_WITHDRAWAL_ADDRESS"

  # All three networks (mainnet/testnet/sandbox) share the same
  # ethstaker-deposit-cli chain config — the generate-entrypoint hardcodes
  # --chain=joc regardless of NETWORK, per the guide's Step 2-2 command.
  # NETWORK is already exported above, so staking-deposit-cli.yml's
  # ${NETWORK} volume interpolation (validator-import) resolves correctly.
  docker compose -f "$JOCD_ROOT/staking-deposit-cli.yml" run --rm \
    -e HOST_UID="$(id -u)" \
    -e HOST_GID="$(id -g)" \
    deposit-generate

  info "Step 2-6: importing the validator key into the Lighthouse Validator Client..."
  docker compose -f "$JOCD_ROOT/staking-deposit-cli.yml" run --rm \
    -e HOST_UID="$(id -u)" \
    -e HOST_GID="$(id -g)" \
    validator-import
  success "Validator key imported."

  # --- .env ------------------------------------------------------------------
  info "Preparing .env..."
  if [[ ! -f "$ENV_FILE" ]]; then
    [[ -f "$ENV_EXAMPLE" ]] || die "$ENV_EXAMPLE not found."
    cp "$ENV_EXAMPLE" "$ENV_FILE"
  fi
  set_env_var "NETWORK" "$NETWORK"
  set_env_var "ROLE" "$ROLE"
  set_env_var "COMPOSE_FILE" "$compose_file"
  set_env_var "CL_CLIENT" "$CL_CLIENT"
  set_env_var "WITHDRAWAL_ADDRESS" "$VALIDATOR_WITHDRAWAL_ADDRESS"

  if ! grep -q '^BEACON_URL=http://beacon:5052$' "$ENV_FILE"; then
    warn "BEACON_URL is a safe local placeholder until you run:"
    warn "  jocd validator config beacon http://<bccloud-node-ip>:3500"
    warn "once Step 2-3~2-5 are done on BCCloud."
  fi

  # --- Start -------------------------------------------------------------------
  info "Starting the Validator Client via docker compose..."
  ( cd "$JOCD_ROOT" && docker compose up -d )
  success "Started. Check status with: jocd status"

  # --- Final summary -----------------------------------------------------------
  echo >&2
  echo "================================================================" >&2
  success "Setup complete on network '$NETWORK'."

  shopt -s nullglob
  local deposit_files=("$KEYS_DIR"/deposit_data-*.json)
  shopt -u nullglob
  local deposit_file="${deposit_files[0]:-<not found>}"
  echo >&2
  info "Deposit data file — you will submit this to Launchpad in Step 3-1:"
  echo "  $deposit_file" >&2
  echo >&2
  shout "CONFIDENTIAL — do not share with ANYONE, including JBF/admin/BCCloud staff:"
  shout "  - the mnemonic (already cleared from this terminal, was never written to disk)"
  shout "  - $KEYS_DIR/keystore-*.json"
  shout "  - $KEYS_DIR/password.txt"
  echo "================================================================" >&2
}

# --- jocd validator config [<key> [<value>]] ----------------------------------------
# Single, extensible entry point for validator-scoped settings — no
# argument: print every known key's current value. One key, no value:
# print just that one. Key + value: validate, write to .env, offer to
# apply. Doesn't touch keys — for first-time setup (including key
# generation), use 'jocd init'.
#
# Adding a new setting later (e.g. graffiti) means adding its name to
# VALIDATOR_CONFIG_KEYS below plus one case arm each in
# _validator_config_show()/_validator_config_set() — cmd_validator_config
# itself (the view-all/view-one/confirm-and-apply flow) never changes.
# Keep this array as the single source of truth, same spirit as the
# SUPPORTED_* allow-lists above.
VALIDATOR_CONFIG_KEYS=(address beacon)

cmd_validator_config() {
  [[ -f "$ENV_FILE" ]] || die "$ENV_FILE not found. Run 'jocd init' first."
  load_env

  local key="${1:-}" value="${2:-}"

  if [[ -z "$key" ]]; then
    local k
    for k in "${VALIDATOR_CONFIG_KEYS[@]}"; do
      _validator_config_show "$k"
    done
    return 0
  fi

  _list_contains "$key" "${VALIDATOR_CONFIG_KEYS[@]}" \
    || die "Unknown key '$key'. Known keys: ${VALIDATOR_CONFIG_KEYS[*]}"

  if [[ -z "$value" ]]; then
    _validator_config_show "$key"
    return 0
  fi

  _validator_config_set "$key" "$value"

  check_docker
  if confirm "Apply now via 'docker compose up -d'?"; then
    ( cd "$JOCD_ROOT" && docker compose up -d )
    success "Applied. Check with: jocd status"
  else
    info "Not applied yet — run 'jocd up' when ready."
  fi
}

# Prints one key's current value. Guide references: 'address' is Step
# 2-7's --suggested-fee-recipient; 'beacon' is the Consensus Client the
# Validator Client connects to (Step 2-7 initial connection / Step 4-1
# endpoint changes).
_validator_config_show() {
  case "$1" in
    address) echo "address = ${WITHDRAWAL_ADDRESS:-<unset>}" >&2 ;;
    beacon)  echo "beacon  = ${BEACON_URL:-<unset>}" >&2 ;;
  esac
}

# Validates + writes one key's new value to .env. This is the only place
# that needs to know a given key's validation rule.
_validator_config_set() {
  local key="$1" value="$2"
  case "$key" in
    address)
      is_valid_eth_address "$value" || die "Invalid address. Expected 0x + 40 hex characters."
      set_env_var "WITHDRAWAL_ADDRESS" "$value"
      success "address updated in $ENV_FILE."
      ;;
    beacon)
      is_valid_url "$value" || die "Invalid URL: '$value' (expected http(s)://host[:port][/path])"
      set_env_var "BEACON_URL" "$value"
      success "beacon updated in $ENV_FILE."
      ;;
  esac
}

# --- jocd validator deposit-data -----------------------------------------------------
# Reprint the deposit_data-*.json path + contents generated by 'jocd init'
# (guide Step 3-1) — for whenever you need it again after the one-time
# printout at init time (e.g. lost terminal scrollback). Public data only
# (pubkey/signature/withdrawal credentials) — never touches the mnemonic
# or any secret file.
cmd_validator_deposit_data() {
  [[ -f "$ENV_FILE" ]] || die "$ENV_FILE not found. Run 'jocd init' first."
  load_env

  shopt -s nullglob
  local deposit_files=("$KEYS_DIR"/deposit_data-*.json)
  shopt -u nullglob
  [[ ${#deposit_files[@]} -gt 0 ]] \
    || die "No deposit_data-*.json found in $KEYS_DIR. Run 'jocd init' first."

  info "Deposit data file (guide Step 3-1 — submit this yourself if you haven't already):"
  echo "  ${deposit_files[0]}" >&2
  echo >&2
  info "Contents, for copy/paste:"
  echo "----------------------------------------------------------------" >&2
  cat "${deposit_files[0]}"
  echo >&2
  echo "----------------------------------------------------------------" >&2
}

# --- jocd status -------------------------------------------------------------------
# Check the validator container's health, per guide Step 3-2.
cmd_status() {
  check_docker
  [[ -f "$ENV_FILE" ]] && load_env || true

  local services=("validator")
  local overall_ok=true svc not_attesting_count
  for svc in "${services[@]}"; do
    echo >&2
    if ! docker ps --filter "name=^/${svc}\$" --format '{{.Names}}' | grep -q "^${svc}\$"; then
      error "Container '$svc' is not running."
      docker ps -a --filter "name=^/${svc}\$"
      overall_ok=false
      continue
    fi
    success "Container '$svc' is running:"
    docker ps --filter "name=^/${svc}\$"

    info "Last 20 log lines for '$svc':"
    docker logs --tail 20 "$svc" 2>&1 || true

    if [[ "$svc" == "validator" ]]; then
      not_attesting_count="$(docker logs --tail 500 "$svc" 2>&1 | grep -c "Not attesting" || true)"
      if [[ "$not_attesting_count" -gt 0 ]]; then
        warn "Found $not_attesting_count recent 'Not attesting' log line(s)."
        warn "Per the guide (Step 3-2): if this keeps appearing for more than"
        warn "15-20 minutes (after the first 5-10 minutes of startup), the"
        warn "validator is not operating properly. Contact JBF/admin if it persists."
      else
        success "No 'Not attesting' messages in the last 500 log lines."
      fi
    fi
  done

  [[ "$overall_ok" == true ]] || return 1
}

# --- jocd upgrade ----------------------------------------------------------------------
# Update this CLI itself (this file, the per-client *.yml compose files,
# and any networks/ files your team commits — including
# networks/<NETWORK>/cl/config.yaml, e.g. for a new hard fork phase) via
# `git pull`. Loosely modeled on eth-docker's `ethd update`, but much
# simpler: no OS package management, no .env migration, no automatic
# container restart or config apply — applying a pulled-in config.yaml
# change is a deliberate follow-up step ('jocd restart'), not automatic.
# Named 'upgrade' rather than 'update' to avoid the old, confusingly
# similar 'update'/'update-config' pair this project used to have.
cmd_upgrade() {
  [[ -d "$JOCD_ROOT/.git" ]] \
    || die "$JOCD_ROOT is not a git checkout. Clone this repo with 'git clone' to use 'jocd upgrade'."
  command -v git >/dev/null 2>&1 || die "git is required for 'jocd upgrade'."

  cd "$JOCD_ROOT"

  # Only ask when there's something to lose. A clean tree pulls straight
  # through below (git pull --ff-only is always safe/reversible on its
  # own); dirty local changes get an explicit yes/no, since 'git pull
  # --ff-only' can still fail partway if the incoming changes touch the
  # same files — better to ask upfront than let git sort it out silently.
  if [[ -n "$(git status --porcelain)" ]]; then
    warn "This checkout has local changes (git status is not clean):"
    git status --short >&2
    confirm "Continue anyway? ('git pull --ff-only' will abort safely if this conflicts)" \
      || die "Aborted. Commit, stash, or discard local changes first, then re-run 'jocd upgrade'."
  fi

  local branch
  branch="$(git branch --show-current)"
  [[ -n "$branch" ]] || die "Not on a branch (detached HEAD). Check out a branch before updating."

  info "Fetching latest changes for '$branch' from origin..."
  git fetch origin "$branch"

  local behind_count
  behind_count="$(git rev-list --count "HEAD..origin/$branch")"
  if [[ "$behind_count" -eq 0 ]]; then
    success "Already up to date ($(git rev-parse --short HEAD))."
    return 0
  fi

  # --no-pager: without it, git still invokes a pager here even though
  # stdout is redirected to &2 (it decides based on the underlying fd,
  # which is still the terminal) — that turned an informational listing
  # into an unexpected "Press RETURN to continue" prompt.
  info "$behind_count new commit(s) available on '$branch':"
  git --no-pager log --oneline "HEAD..origin/$branch" >&2
  echo >&2

  # Look ahead at what's changing under paths that affect a running
  # node, so we can tell you what to do next instead of acting on it.
  local compose_changed
  compose_changed="$(git diff --name-only "HEAD..origin/$branch" -- '*.yml' || true)"
  local cl_config_changed
  cl_config_changed="$(git diff --name-only "HEAD..origin/$branch" -- 'networks/*/cl/config.yaml' || true)"

  git pull --ff-only origin "$branch"
  success "Updated to $(git rev-parse --short HEAD)."

  if [[ -n "$compose_changed" ]]; then
    warn "Compose file(s) changed:"
    echo "$compose_changed" | sed 's/^/  /' >&2
    warn "Review the diff, then run 'jocd up' to apply."
  fi
  if [[ -n "$cl_config_changed" ]]; then
    warn "Consensus config changed (likely a new hard fork phase):"
    echo "$cl_config_changed" | sed 's/^/  /' >&2
    warn "Confirm your team verified this against the official JBF/admin"
    warn "source, then run 'jocd restart' so the validator container picks"
    warn "it up (bind-mounted, no rebuild needed)."
  fi
}

# --- jocd up -------------------------------------------------------------------------
# (Re)start the validator service, per the current .env (including which
# compose file COMPOSE_FILE points at) — also picks up any compose
# file/.env change (see 'jocd restart' for the difference).
cmd_up() {
  check_docker
  [[ -f "$ENV_FILE" ]] || die "$ENV_FILE not found. Run 'jocd init' first."
  load_env

  ( cd "$JOCD_ROOT" && docker compose up -d )
  success "Up (role: ${ROLE:-<unset>}, compose file(s): ${COMPOSE_FILE:-<unset>}). Check with: jocd status"
}

# --- jocd down -----------------------------------------------------------------------
# Stop and remove this node's container(s) (--remove-orphans in case ROLE
# or COMPOSE_FILE changed since the last 'jocd up'). Reversible: data/ and
# .env are left untouched — bring the node back with 'jocd up'. For
# permanently deleting keys/deposit data/.env instead, see 'jocd destroy'.
cmd_down() {
  check_docker
  [[ -f "$ENV_FILE" ]] && load_env || true

  if [[ "${ROLE:-validator}" == "validator" || "${ROLE:-validator}" == "all" ]]; then
    warn "Guide note (Step 3-2): do not stop the Validator Client while awaiting activation."
  fi
  confirm "Stop the node now?" || die "Aborted."

  ( cd "$JOCD_ROOT" && docker compose down --remove-orphans )
  success "Stopped. Start again with: jocd up"
}

# --- jocd restart --------------------------------------------------------------------
# `docker compose restart validator`. Restarts the existing container in
# place — re-reads any bind-mounted file that changed on disk (e.g.
# networks/<NETWORK>/cl/config.yaml after a hard fork config update
# pulled in via 'jocd upgrade' — guide Step 4-1's "sudo docker restart
# validator"). Does NOT recreate the container: a changed compose file or
# .env value needs 'jocd up' instead, not this (see README.md).
cmd_restart() {
  check_docker
  [[ -f "$ENV_FILE" ]] || die "$ENV_FILE not found. Run 'jocd init' first."
  load_env

  info "Restarting: validator..."
  ( cd "$JOCD_ROOT" && docker compose restart validator )
  success "Done. Check with: jocd status"

  warn "Per the guide: after 5-10 minutes, if 'Not attesting' keeps appearing"
  warn "for more than 15-20 minutes, the validator is not operating properly."
}

# --- jocd destroy --------------------------------------------------------------------
# Stop this node's containers AND permanently delete its data (keys,
# deposit data, the Validator Client's own datadir) and .env. NOT
# reversible.
#
# Deliberately a separate command from 'jocd down' rather than a
# '--data'/'--all' flag on it — no accidentally-omitted flag can turn a
# routine stop into an irreversible wipe. For just stopping containers
# (reversible), use 'jocd down' instead.
cmd_destroy() {
  check_docker

  echo >&2
  shout "=================================================================="
  shout " 'jocd destroy' will stop this node's containers AND PERMANENTLY"
  shout " DELETE:"
  [[ -d "$KEYS_DIR" ]] && shout "   - $KEYS_DIR"
  shout "     (mnemonic-derived keystore, deposit_data-*.json, password.txt)"
  [[ -d "$DATA_DIR" ]] && shout "   - all of $DATA_DIR (the Validator Client's own datadir)"
  [[ -f "$ENV_FILE" ]] && shout "   - $ENV_FILE (network/withdrawal address settings)"
  shout ""
  shout " If deposit_data-*.json was already submitted to Launchpad for this"
  shout " validator, deleting its keystore/mnemonic means you can NEVER"
  shout " operate that validator again. There is no undo, and no backup is"
  shout " made — networks/ (public config) is untouched, but everything"
  shout " under data/ and .env is gone."
  shout "=================================================================="

  confirm "Are you certain this validator's deposit (if any) is fully decommissioned, or was never submitted?" \
    || die "Aborted. Nothing was deleted."

  confirm_strict "Permanently delete $DATA_DIR and $ENV_FILE?" "delete" \
    || die "Confirmation text did not match. Aborted. Nothing was deleted."

  info "Stopping and removing containers for this node..."
  ( cd "$JOCD_ROOT" && docker compose down --remove-orphans )

  rm -rf "$DATA_DIR" "$ENV_FILE"
  success "Removed $DATA_DIR and $ENV_FILE. Run 'jocd init' to start fresh."
}

# --- jocd logs ---------------------------------------------------------------------
# Follow the validator container's logs. For a one-shot health check
# instead, use 'jocd status'.
cmd_logs() {
  check_docker
  [[ -f "$ENV_FILE" ]] && load_env || true

  ( cd "$JOCD_ROOT" && docker compose logs -f --tail 100 validator )
}

# =============================================================================
# 4. Usage + dispatch
# =============================================================================
usage() {
  cat <<'EOF'
jocd — JOC Validator Client CLI

Usage:
  jocd install                     Install Docker (Engine + compose plugin) if missing
  jocd init                        Set up this node: prompts for NETWORK
                                    (mainnet|testnet|sandbox), then runs
                                    the guide's Step 2

  jocd validator config [<key> [<value>]]
                                    View all validator settings, one key, or
                                    set + apply one (keys: address, beacon —
                                    'jocd validator config' with no args
                                    lists all of them)
  jocd validator deposit-data      Reprint the deposit_data-*.json path +
                                    contents from 'jocd init' (Step 3-1)

  jocd status                      Check the validator container (Step 3-2)
  jocd up                          Start/apply the validator service (also
                                    picks up compose file/.env changes)
  jocd down                        Stop it
  jocd restart                     docker compose restart — for a hard fork
                                    config.yaml update (Step 4-1) or similar;
                                    does NOT pick up compose file/.env changes
  jocd logs                        Follow the validator container's logs
  jocd destroy                     Stop containers AND PERMANENTLY delete
                                    keys/deposit data/.env (NOT reversible —
                                    separate from 'jocd down' on purpose)

  jocd upgrade                     Update this CLI itself via 'git pull' (code +
                                    any networks/ files your team commits, e.g.
                                    a new networks/<NETWORK>/cl/config.yaml)

Run 'jocd <command>' with no further arguments for command-specific usage.
See README.md for the full walkthrough, prerequisites, and links to the
manual BCCloud steps this CLI does NOT automate.
EOF
}

main() {
  local cmd="${1:-}"
  [[ $# -gt 0 ]] && shift || true

  case "$cmd" in
    install)   cmd_install "$@" ;;
    init)      cmd_init "$@" ;;
    validator)
      local sub="${1:-}"
      [[ $# -gt 0 ]] && shift || true
      case "$sub" in
        config)       cmd_validator_config "$@" ;;
        deposit-data) cmd_validator_deposit_data "$@" ;;
        *)
          echo "Usage: jocd validator <config [<key> [<value>]]|deposit-data>" >&2
          exit 1
          ;;
      esac
      ;;
    status)    cmd_status "$@" ;;
    upgrade)   cmd_upgrade "$@" ;;
    up)        cmd_up "$@" ;;
    down)      cmd_down "$@" ;;
    restart)   cmd_restart "$@" ;;
    destroy)   cmd_destroy "$@" ;;
    logs)      cmd_logs "$@" ;;
    -h | --help | help | "")
      usage
      ;;
    *)
      echo "Unknown command: $cmd" >&2
      usage
      exit 1
      ;;
  esac
}

main "$@"
