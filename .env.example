# Copy this file to `.env` (jocv init does this for you) and fill in values.
# Never commit the real `.env` — see .gitignore.

# --- Network -----------------------------------------------------------------
# Which JOC network to run: mainnet | testnet | sandbox
# Each has its own directory under networks/<NETWORK>/ (see networks/README.md).
# Changing this after 'jocv init' is not supported — keys/deposit data are
# network-specific. Run 'jocv init' again in a fresh checkout for another network.
NETWORK=mainnet

# --- Clients -------------------------------------------------------------------
# Execution Layer client. Currently supported: geth
# (planned, not yet available: nethermind, besu)
EL_CLIENT=geth

# Consensus Layer / Validator client. Currently supported: lighthouse
# (planned, not yet available: prysm)
CL_CLIENT=lighthouse

# --- Role ------------------------------------------------------------------------
# Which service(s) docker compose starts:
#   validator - only the Validator Client, connecting to an external Consensus
#               Client (e.g. BCCloud). This is the guide's Option 2
#               (Recommended Configuration) and is the only role covered by
#               the official guide's Step 2.
#   el-cl     - only Execution + Consensus clients (join/sync the network,
#               no validator duties). For running a plain node.
#   all       - Execution + Consensus + Validator, all self-hosted. This is
#               the guide's Option 3, which the official guide does NOT
#               document in detail ("contact us directly") — the
#               execution/beacon service wiring for this role is inferred
#               from standard Geth/Lighthouse usage, NOT guide-verbatim.
#               Verify with JBF/admin before relying on it in production.
ROLE=validator

# Managed by jocv based on ROLE (see scripts/lib.sh: profiles_for_role).
# Edit ROLE above and re-run 'jocv init' or 'jocv role set <role>' instead of
# editing this directly.
COMPOSE_PROFILES=validator

# --- Only used when ROLE is el-cl or all (self-hosted Execution Client) --------
# Geth image to run. Left unset on purpose: this repo does not know which
# Geth version JOC recommends (the guide doesn't cover Option 3 at all).
# Get the correct value from JBF/admin before setting ROLE to el-cl or all.
#EL_CLIENT_IMAGE=

# Numeric network ID for --networkid. Same caveat as above.
#EL_NETWORK_ID=

# --- Validator role settings ---------------------------------------------------
# Receiver withdrawal address obtained in Step 1-1. Also passed as
# --suggested-fee-recipient to the Validator Client (Step 2-7).
WITHDRAWAL_ADDRESS=0x0000000000000000000000000000000000000000

# Consensus Client / Beacon Node HTTP API URL.
#   ROLE=validator -> the BCCloud node opened in Step 2-5 (set via
#                      'jocv beacon set http://<bccloud-node-ip>:3500').
#   ROLE=all       -> auto-managed by jocv, points at the local 'beacon'
#                      service (http://beacon:5052) — do not hand-edit.
# This placeholder is a safe, local, non-functional value so the container
# can start without accidentally connecting anywhere real.
BEACON_URL=http://127.0.0.1:5052
