# Copy this file to `.env` (jocd init does this for you) and fill in values.
# Never commit the real `.env` — see .gitignore.

# --- Network -----------------------------------------------------------------
# Which JOC network to run: mainnet | testnet | sandbox
# Each has its own directory under networks/<NETWORK>/ (see networks/README.md).
# Changing this after 'jocd init' is not supported — keys/deposit data are
# network-specific. Run 'jocd init' again in a fresh checkout for another network.
NETWORK=mainnet

# --- Client ----------------------------------------------------------------------
# Consensus Layer / Validator client. Currently supported: lighthouse
# (planned, not yet available: prysm)
CL_CLIENT=lighthouse

# --- Role ------------------------------------------------------------------------
# Only 'validator' is supported right now: the Validator Client only,
# connecting to an external Consensus Client (e.g. BCCloud). This is the
# guide's Option 2 (Recommended Configuration) and the only role covered
# by the official guide's Step 2.
#
# Self-hosting your own Execution + Consensus Client (guide Option 3,
# which the guide itself doesn't document) used to be supported here as
# ROLE=el-cl/all — removed for now rather than carried forward
# half-finished. See git history if that gets properly rebuilt.
ROLE=validator

# Which compose file gets loaded — managed by jocd (compose_files_for_role()).
# docker compose reads COMPOSE_FILE natively from .env, no -f flags needed.
# Edit ROLE above and re-run 'jocd init' (or 'jocd up') instead of editing
# this directly.
COMPOSE_FILE=lighthouse-vc-only.yml

# --- Validator settings ---------------------------------------------------------
# Receiver withdrawal address obtained in Step 1-1. Also passed as
# --suggested-fee-recipient to the Validator Client (Step 2-7).
WITHDRAWAL_ADDRESS=0x0000000000000000000000000000000000000000

# Consensus Client / Beacon Node HTTP API URL — the BCCloud node opened in
# Step 2-5 (set via 'jocd validator config beacon http://<bccloud-node-ip>:3500').
# This placeholder is a safe, local, non-functional value so the container
# can start without accidentally connecting anywhere real.
BEACON_URL=http://127.0.0.1:5052
